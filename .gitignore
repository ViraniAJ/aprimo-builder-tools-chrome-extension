# Never commit: the extension's private signing key, local settings and secrets
keys/
*.pem
*.crx
.env
extension/app/defaults.json
backups/
.claude/

# Dependencies and build leftovers
node_modules/
dist/
.DS_Store

# Parked work (Report Labs port drafts), kept on the local machine only
labs/

# Aprimo Wisp: generated at build time (npm run build:tools, npm run wisp:assets); release.sh adds them to the zip
extension/app/wisp/*.js
extension/app/wisp/chunks/
extension/app/wisp/wisp.css
extension/content/wisp-agent.js
extension/vendor/
extension/models/
knowledge/.cache/
