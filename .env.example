# Copy to .env and fill in. Never commit .env.
# Tenant name only: "mycompany" for https://mycompany.dam.aprimo.com
APRIMO_DOMAIN=
# From Aprimo: Administration > Integration > Registrations (Client Credentials, scope "api")
APRIMO_CLIENT_ID=
APRIMO_CLIENT_SECRET=

# Optional
PORT=4317
# Set to 1 to block every create, edit, enable/disable and delete
READ_ONLY=0
