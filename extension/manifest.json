{
  "manifest_version": 3,
  "name": "Aprimo Builder Tools",
  "version": "0.11.0",
  "description": "External builder tools inside Aprimo: Rules Manager, Job Log Search, Bulk Versioning and Aprimo Wspr (an AI guide that answers, speaks and points), using your own Aprimo sign-in.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "identity",
    "storage",
    "sidePanel",
    "activeTab",
    "scripting",
    "tts",
    "alarms",
    "notifications",
    "unlimitedStorage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.aprimo.com/*",
    "https://integrate.api.nvidia.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Aprimo Builder Tools"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.dam.aprimo.com/*"
      ],
      "js": [
        "features.js",
        "content/overlay.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.aprimo.com/*"
      ],
      "js": [
        "content/page-token.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.aprimo.com/*"
      ],
      "js": [
        "content/token-relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.aprimo.com/*"
      ],
      "exclude_matches": [
        "https://*.dam.aprimo.com/*"
      ],
      "js": [
        "content/aprimo-nav.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.aprimo.com/*"
      ],
      "js": [
        "content/wisp-agent.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "app/*"
      ],
      "matches": [
        "https://*.aprimo.com/*"
      ]
    }
  ],
  "optional_permissions": [
    "clipboardRead"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "side_panel": {
    "default_path": "app/wisp/panel.html"
  },
  "commands": {
    "wisp-talk": {
      "suggested_key": {
        "default": "Alt+Shift+Space",
        "mac": "Alt+Shift+Space"
      },
      "description": "Ask Aprimo Wspr (press again to stop listening)"
    }
  },
  "storage": {
    "managed_schema": "wisp-managed-schema.json"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
