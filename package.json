{
  "name": "aprimo-builder-tools-chrome-extension",
  "version": "0.10.5",
  "private": true,
  "description": "Chrome extension adding community-built tools (Rules Manager, Job Log Search, Bulk Versioning) to Aprimo Administration",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "mock": "node server.js --mock",
    "build:ext": "node scripts/build-extension.mjs",
    "fake-aprimo": "node dev/fake-aprimo.js",
    "build:tools": "node scripts/build-tools.mjs",
    "release": "sh scripts/release.sh"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/cli": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "aprimo-js": "^2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "fflate": "0.8.3",
    "lucide-react": "^0.564.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.1",
    "sonner": "1.7.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.3.3",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "license": "BSD-3-Clause"
}
