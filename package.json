{
  "name": "aprimo-builder-tools-chrome-extension",
  "version": "0.11.0",
  "private": true,
  "description": "Chrome extension adding community-built tools (Rules Manager, Job Log Search, Bulk Versioning, Aprimo Wisp) to Aprimo Administration",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "mock": "node server.js --mock",
    "build:ext": "node scripts/build-extension.mjs",
    "fake-aprimo": "node dev/fake-aprimo.js",
    "build:tools": "node scripts/build-tools.mjs",
    "release": "sh scripts/release.sh",
    "wisp:assets": "env -u SSL_CERT_FILE node scripts/wisp-assets.mjs",
    "kb:build": "env -u SSL_CERT_FILE node scripts/kb/build.mjs",
    "kb:verify": "node scripts/kb/verify.mjs",
    "wisp:eval": "env -u SSL_CERT_FILE node scripts/wisp-eval.mjs",
    "typecheck": "tsc --noEmit -p tools-src/aprimo-wisp",
    "test": "vitest run"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/cli": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "aprimo-js": "^2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "fflate": "0.8.3",
    "linkedom": "^0.18.15",
    "lucide-react": "^0.564.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.1",
    "sonner": "1.7.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "turndown": "^7.2.5",
    "tw-animate-css": "^1.3.3",
    "typescript": "^5.9.3",
    "unpdf": "^2.2.1",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
  "license": "BSD-3-Clause",
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@mlc-ai/web-llm": "^0.2.89"
  }
}
